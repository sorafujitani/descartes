{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true
  },
  "include": [
    "vite.config.ts",
    "apps/web/src",
    "apps/web/*.ts",
    "apps/web/.storybook",
    "apps/api/src",
    "packages/shared/src",
    "tests"
  ]
}
